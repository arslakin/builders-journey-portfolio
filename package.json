{
  "name": "builders-journey-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "^26.0.0",
    "npm": "^11.0.0"
  },
  "scripts": {
    "dev": "vite --mode development",
    "build": "tsc -b && vite build --mode production",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "validate:production": "node --experimental-strip-types ./scripts/validate.ts production",
    "validate:production:config": "node --experimental-strip-types ./scripts/validate.ts config",
    "validate:production:content": "node --experimental-strip-types ./scripts/validate.ts content",
    "validate:production:output": "node --experimental-strip-types ./scripts/validate.ts output",
    "validate:deployment-claims": "node --experimental-strip-types ./scripts/validate.ts deployment-claims",
    "validate:secrets:source": "node --experimental-strip-types ./scripts/validate.ts source",
    "validate:secrets:dist": "node --experimental-strip-types ./scripts/validate.ts assets",
    "verify:deployment": "node --experimental-strip-types ./scripts/verify-deployment.ts",
    "test": "vitest run",
    "test:browser:install": "playwright install --only-shell chromium",
    "test:browser": "npm run build && playwright test --grep-invert @a11y",
    "test:a11y": "npm run build && playwright test --grep @a11y"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
